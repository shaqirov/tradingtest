# Copy to .env and fill in. Freqtrade maps FREQTRADE__A__B to config["a"]["b"].
# Values here override user_data/config.json.

# Exchange API keys (leave empty for dry-run)
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Telegram notifications (optional)
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# FreqUI / REST API credentials — CHANGE THESE
FREQTRADE__API_SERVER__USERNAME=freqtrader
FREQTRADE__API_SERVER__PASSWORD=change-me
FREQTRADE__API_SERVER__JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
FREQTRADE__API_SERVER__WS_TOKEN=change-me-too
